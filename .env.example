# ---------------------------------------------------------------------------
# Agentic Procurement Automation — environment template
# Copy to .env and fill in values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=Europe/Berlin

# --- ERPNext (official frappe_docker pwd.yml demo stack) ---
ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_SITE=frontend
ERPNEXT_ADMIN_USER=Administrator
ERPNEXT_ADMIN_PASSWORD=admin
# Generated after first login / API key creation (Stage 1 discovery)
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_TIMEOUT_SECONDS=30

# --- App Postgres (proposals, approvals, audit, pgvector, checkpoints) ---
DATABASE_URL=postgresql+psycopg://procurement:procurement@localhost:5433/procurement

# --- LLM (reasoning / tool calling) ---
# Providers: openai | deepseek | anthropic | gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Optional alternate providers (kept for enterprise swap demos)
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Embeddings (default: local HuggingFace via fastembed — no cloud call) ---
# Providers: local | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Only used when EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Slack (Stage 6) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
# Comma-separated Slack user IDs allowed to approve ERP writes
SLACK_APPROVER_USER_IDS=
# Channel where /propose posts the approval card. Starts with C.
SLACK_CHANNEL_ID=

# --- Approval / safety ---
# Hard-coded allowlist also enforced in backend code (not by LLM prompts)
REQUIRE_HUMAN_APPROVAL_FOR_ERP_WRITES=true
